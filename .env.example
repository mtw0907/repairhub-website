# Vercel 프로젝트 → Storage → Postgres 추가 후 발급되는 연결문자열 (로컬 개발도 동일한 DB 사용)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Vercel 프로젝트 → Storage → Blob 추가 후 발급되는 토큰 (업체 사진/사업자등록증 업로드용)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

AUTH_SECRET="replace-with-a-long-random-string"

# 운영 배포 시 실제 도메인으로 설정 (sitemap.xml/robots.txt에 사용). 로컬 개발은 생략 가능.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# 배포 플랫폼이 호스트 헤더 신뢰 관련 오류를 낼 경우에만 추가 (NextAuth v5).
# AUTH_TRUST_HOST=true

# 토스페이먼츠 정기결제(빌링) 자동 재청구 크론(/api/cron/subscriptions/renew) 인증용.
# 임의의 긴 랜덤 문자열로 생성해 Vercel 환경변수에도 동일하게 등록.
CRON_SECRET="replace-with-a-long-random-string"
