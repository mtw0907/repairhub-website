// RepairHub — Phase 1 data model
// SQLite connector does not support native `enum`, so role/status fields are
// declared as String here. Allowed values are documented above each field as
// a comment; validate them with the TS unions in src/lib/constants.ts.
// When migrating to Postgres, these String fields can be converted to
// Prisma `enum` types with the same value sets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: USER | PARTNER | ADMIN | SUPER_ADMIN
// status: ACTIVE | SUSPENDED | DELETED
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String
  phone     String?
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  termsAgreedAt DateTime? // 이용약관·개인정보처리방침 동의 시각 (가입 폼 경유 시에만 설정)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when role == PARTNER: the company this user manages.
  companyId String?
  company   Company? @relation("CompanyOwner", fields: [companyId], references: [id])

  reservations      Reservation[]
  estimates         Estimate[]
  repairRequests    RepairRequest[]
  reviews           Review[]
  favorites         Favorite[]
  recentViews       RecentView[]
  inquiries         Inquiry[]
  reportsFiled      Report[]           @relation("ReportReporter")
  adminActivityLogs AdminActivityLog[]
  aiUsageLogs       AiUsageLog[]
  payments          Payment[]
  notifications     Notification[]

  @@index([role])
}

// status: PENDING | APPROVED | SUSPENDED | UNVERIFIED
model Company {
  id            String   @id @default(cuid())
  name          String
  ownerName     String? // 대표자
  bizRegNo      String? // 사업자번호
  address       String?
  region        String? // AI 지역 페이지 생성용 (시/도, 시/군/구)
  phone         String?
  homepage      String?
  sns           String? // JSON: { instagram, youtube, facebook, ... }
  introduction  String?
  seoDescription String? // AI SEO 생성용 메타 설명
  logoUrl       String?
  photos        String? // JSON array of photo URLs
  businessHours String? // JSON: { mon: "10:00-19:00", ... }
  closedDays    String? // JSON array e.g. ["SUN"]
  latitude      Float?
  longitude     Float?
  certificateUrl String? // 사업자등록증 이미지 URL (자기가입 시 제출)
  aiVerificationResult String? // JSON: AI 1차 검토 결과 (참고용, 최종 승인은 관리자가 함) — {ok:true,...} | {ok:false,reason}
  status        String   @default("UNVERIFIED")
  isPremium     Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  billingKey         String? // 토스페이먼츠 빌링키 (자동결제용 카드 등록 시 발급)
  billingCustomerKey String? // 빌링키 발급에 쓰인 고유 식별자
  autoRenew          Boolean @default(true) // false면 만료일에 자동 재청구하지 않음
  onSiteVisit   Boolean  @default(false) // 출장 가능
  courierDrop   Boolean  @default(false) // 택배 가능
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owners        User[]         @relation("CompanyOwner")
  services      Service[]
  brands        Brand[]
  priceItems    PriceItem[]
  reservations  Reservation[]
  estimates     Estimate[]
  reviews       Review[]
  favorites     Favorite[]
  recentViews   RecentView[]
  inquiries     Inquiry[]
  ads           Ad[]
  subscriptions Subscription[]
  workCases     WorkCase[]
  quotes        Quote[]

  @@index([status])
  @@index([region])
}

model Service {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model PriceItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  createdAt DateTime @default(now())

  @@index([companyId])
}

// status: REQUESTED | APPROVED | CONFIRMED | IN_PROGRESS | CHANGED | CANCELED | COMPLETED | NO_SHOW
model Reservation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  status        String    @default("REQUESTED")
  method        String    @default("VISIT") // VISIT(방문) | ONSITE(출장) | COURIER(택배)
  visitAddress  String? // ONSITE 출장 요청 시 방문지 주소 (COURIER 반송 주소로도 재사용)
  instrumentCategory String? // INSTRUMENT | AUDIO_EQUIPMENT
  instrument    String? // 기타/베이스/피아노/... 또는 앰프/스피커/... (RepairRequest.instrument와 동일한 값 집합)
  brand         String?
  symptom       String?
  scheduledAt   DateTime?
  memo          String? // 파트너 예약 메모
  notifyEnabled Boolean   @default(true) // 예약 관련 인앱 알림 수신 여부
  completedAmount Int? // COMPLETED 처리 시 파트너가 직접 입력하는 실 청구 금액 (매출 집계용, 결제 연동 아님)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  statusLogs ReservationStatusLog[]

  // Set when this reservation originated from an AI repair-match quote.
  quoteId         String? @unique
  quote           Quote?  @relation(fields: [quoteId], references: [id])
  repairRequestId String?

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([repairRequestId])
}

// 예약 상태가 바뀔 때마다 기록되는 이력 (단계별 진행 화면에서 정확한 시각 표시용)
model ReservationStatusLog {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status        String
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

// status: REQUESTED | ANSWERED | CLOSED
model Estimate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  request   String
  answer    String?
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}

// AI 수리 견적 매칭 시스템: 증상 입력 → AI 분석 → 지역 기반 업체 매칭 → 견적 비교 → 예약.
// status: SUBMITTED | ANALYZED | MATCHING | QUOTED | RESERVED | CLOSED
model RepairRequest {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  category  String // INSTRUMENT | AUDIO_EQUIPMENT
  instrument String // 기타/베이스/피아노/바이올린/드럼/관악기/앰프/스피커/믹서/마이크/오디오인터페이스
  brand     String?
  symptom   String
  photos    String? // JSON array of photo URLs
  videos    String? // JSON array of video URLs
  aiResult  String? // JSON: {causes:[{rank,label,description}], priceMin, priceMax, specialties:string[]}

  // 업체 매칭 설정 (Step 4) — regionScope: DONG | GU | SI
  regionScope String?
  regionValue String?
  filters     String? // JSON: {onSiteOnly, sameDayOnly, brandSpecialist, instrumentSpecialist, highRatedOnly}

  matchedCompanyIds String? // JSON array of Company.id selected by the matching algorithm (max 5)
  status            String  @default("SUBMITTED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotes Quote[]

  @@index([userId])
  @@index([status])
}

// status: PENDING | ACCEPTED | DECLINED
model Quote {
  id              String        @id @default(cuid())
  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id])
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  price           Int
  duration        String // 자유 기재, 예: "2~3일"
  availableDate   DateTime?
  onSiteAvailable Boolean       @default(false)
  message         String?
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reservation Reservation?

  @@unique([repairRequestId, companyId])
  @@index([repairRequestId])
  @@index([companyId])
}

// status: VISIBLE | HIDDEN | REPORTED | DELETED
model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  rating       Int
  content      String
  photos       String? // JSON array of photo URLs
  partnerReply String?
  status       String   @default("VISIBLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports Report[]

  @@index([companyId])
  @@index([status])
}

// targetType: USER | COMPANY | REVIEW | PHOTO
// status: PENDING | RESOLVED | DISMISSED
model Report {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  reason     String
  status     String   @default("PENDING")
  reporterId String
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewId   String?
  review     Review?  @relation(fields: [reviewId], references: [id])
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model RecentView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  viewedAt  DateTime @default(now())

  @@index([userId])
}

// status: OPEN | ANSWERED | CLOSED
model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  message   String
  answer    String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model WorkCase {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  content   String
  photos    String? // JSON array of photo URLs
  seoMeta   String? // AI-generated SEO description
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model Banner {
  id        String    @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
}

model Event {
  id        String    @id @default(cuid())
  title     String
  content   String
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
}

// status: ACTIVE | ENDED
model Ad {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  title     String
  status    String    @default("ACTIVE")
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())

  stats AdStat[]

  @@index([companyId])
}

model AdStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@index([adId])
}

// plan: PRO
// status: ACTIVE | CANCELED | EXPIRED
model Subscription {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  plan      String    @default("PRO")
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endsAt    DateTime?

  payments Payment[]

  @@index([companyId])
}

// status: PENDING | PAID | REFUNDED | FAILED
model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Int
  status         String        @default("PENDING")
  orderName      String?
  paymentKey     String? // PG(토스페이먼츠) 결제 식별자 - 환불/취소 호출에 필요
  createdAt      DateTime      @default(now())

  @@index([userId])
}

// type: DIAGNOSIS(레거시) | RECOMMENDATION(레거시) | COST_ESTIMATE(레거시) | CHATBOT | BLOG | AD_COPY |
//       WORK_CASE | REVIEW_REPLY | FAQ | CUSTOMER_CHAT | SEO | MODERATION |
//       REPORT_CLASSIFY | OPS_REPORT | INQUIRY_CLASSIFY | REPAIR_MATCH_ANALYSIS
// DIAGNOSIS/RECOMMENDATION/COST_ESTIMATE는 AI 수리 견적 매칭 시스템으로 대체되어
// 더 이상 새로 생성되지 않지만, 과거 로그 데이터 보존을 위해 값 자체는 유지한다.
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([type])
}

// action examples: LOGIN_SUCCESS | LOGIN_FAILURE | ROLE_CHANGE | COMPANY_APPROVE | ...
model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// type: RESERVATION_STATUS | NEW_QUOTE | REVIEW_REPLY | INQUIRY_ANSWERED |
//       NEW_RESERVATION | RESERVATION_CHANGED | NEW_REVIEW | NEW_INQUIRY |
//       REPAIR_REQUEST_MATCHED | COMPANY_APPROVED | PARTNER_SIGNUP |
//       REPORT_FILED | ADMIN_ACCOUNT_CHANGED | DB_BACKUP_EVENT
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String? // in-app path to navigate to when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// type: REGION | BRAND | SYMPTOM
// AI가 생성한 SEO 랜딩페이지 콘텐츠. 실제 업체 목록은 keyword로 즉시 조회하며,
// 여기서는 소개글(introText)만 캐싱한다.
model SeoPage {
  id        String   @id @default(cuid())
  type      String
  keyword   String
  title     String
  introText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, keyword])
  @@index([type])
}

// 회원가입 이메일 인증번호(OTP). purpose: REGISTER_USER | REGISTER_PARTNER
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// 고정 윈도우 방식 요청 횟수 제한 카운터. key 예: "login:email:a@b.com",
// "login:ip:1.2.3.4", "register:ip:1.2.3.4". windowStart 이후 windowMs가
// 지나면 다음 요청에서 count가 1로 리셋된다.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
